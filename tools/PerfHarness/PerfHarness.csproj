<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- Not part of LogGrokX.sln on purpose: this is a manual measurement tool.
         DataProj can point at another checkout (e.g. a git worktree of master). -->
    <DataProj Condition="'$(DataProj)' == ''">$(MSBuildThisFileDirectory)../../LogGrokX.Data/LogGrokX.Data.csproj</DataProj>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(DataProj)" />
  </ItemGroup>
</Project>
