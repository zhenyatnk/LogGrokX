<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:avalonDock="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
                    xmlns:avalonDockExtensions="clr-namespace:LogGrokX.AvalonDockExtensions"
                    xmlns:localControls="clr-namespace:LogGrokX.Controls">
    <localControls:StringShortenerConvereter x:Key="StringShortenerConverter" />

    <avalonDockExtensions:DocumentLayoutItemStyleSelector x:Key="DocumentLayoutItemStyleSelector">
        <avalonDockExtensions:DocumentLayoutItemStyleSelector.DefaultStyle>
            <Style TargetType="{x:Type avalonDock:LayoutItem}">
                <Setter Property="Title" Value="{Binding LayoutElement.Title, RelativeSource={RelativeSource Self}}" />
                <Setter Property="ToolTip" Value="{Binding LayoutElement.Title, RelativeSource={RelativeSource Self}}" />
            </Style>
        </avalonDockExtensions:DocumentLayoutItemStyleSelector.DefaultStyle>
        <avalonDockExtensions:DocumentLayoutItemStyleSelector.DocumentStyle>
            <Style TargetType="{x:Type avalonDock:LayoutItem}">
                <Setter Property="ToolTip" Value="{Binding Model.Content.Title}" />
                <Setter Property="Title" Value="{Binding Model.Content.Title}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Model.Content.IsCurrentDocument}" Value="True">
                        <Setter Property="Title" Value="{Binding Model.Content.Title}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Model.Content.IsCurrentDocument}" Value="False">
                        <Setter Property="Title"
                                Value="{Binding Model.Content.Title,
                                    Converter={StaticResource StringShortenerConverter}, ConverterParameter=25}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </avalonDockExtensions:DocumentLayoutItemStyleSelector.DocumentStyle>
    </avalonDockExtensions:DocumentLayoutItemStyleSelector>
</ResourceDictionary>
