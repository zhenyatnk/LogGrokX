<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:markedLines="clr-namespace:LogGrokX.MarkedLines"
                    xmlns:gridView="clr-namespace:LogGrokX.Controls.GridView"
                    xmlns:colors="clr-namespace:LogGrokX.Colors"
                    xmlns:listControls="clr-namespace:LogGrokX.Controls.ListControls"
                    xmlns:textRender="clr-namespace:LogGrokX.Controls.TextRender"
                    mc:Ignorable="d">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ListViewItemStyle.xaml" />
        <ResourceDictionary Source="LogViewContextMenu.xaml" />
        <ResourceDictionary Source="LogGridViewCellStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    <DataTemplate x:Key="MarkedLineCellTemplate">
        <ContentControl Content="{Binding}" Style="{StaticResource LogGridViewCellStyle}" />
    </DataTemplate>
    <Style x:Key="MarkedLinesItemContainerStyle" TargetType="{x:Type ListViewItem}"
           BasedOn="{StaticResource ItemContainerStyle}">
        <Style.Setters>
            <Setter Property="colors:ColorSettings.ColorSettings" Value="{Binding ColorSettings}" />
        </Style.Setters>
    </Style>
    <DataTemplate DataType="{x:Type markedLines:MarkedLinesViewModel}">
        <Grid Margin="10" Visibility="{Binding HaveMarkedLines, 
            Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <listControls:MarkedLinesListView
                SelectionMode="Extended"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderThickness="0"
                Grid.Row="1" ItemsSource="{Binding MarkedLines}"
                ItemContainerStyle="{StaticResource MarkedLinesItemContainerStyle}"
                FontFamily="{StaticResource JetBrainsMono}"
                FontSize="{DynamicResource LogFontSize}"
                VirtualizingStackPanel.IsVirtualizing="True"
                VirtualizingStackPanel.VirtualizationMode="Recycling"
                IsSynchronizedWithCurrentItem="True"
                ReadonlySelectedItems="{Binding SelectedItems, Mode=OneWayToSource}"
                listControls:BaseLogListViewItem.OnItemActivatedCommand="{Binding ItemActivatedCommand}"
                textRender:ClippingRectProviderBehavior.ClippingRectProvider=
                    "{Binding RelativeSource={RelativeSource Self}}">
                <listControls:MarkedLinesListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel
                            Tag="{Binding
                                RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type listControls:MarkedLinesListView}}}"
                            ContextMenu="{StaticResource LogViewContextMenu}" />
                    </ItemsPanelTemplate>
                </listControls:MarkedLinesListView.ItemsPanel>
                <ListView.View>
                    <GridView>
                        <GridViewColumn>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="markedLines:MarkedLineViewModel">
                                    <StackPanel VerticalAlignment="Top" MinWidth="{x:Static gridView:GridViewFactory.PinColumnMinWidth}">
                                        <gridView:PinControl HorizontalAlignment="Center"
                                                             IsChecked="{Binding IsMarked}"/>
                                        <ContentControl Content="{Binding}"
                                                        Focusable="False"
                                                        ContentTemplate="{StaticResource DecodeTogglesTemplate}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Index">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="markedLines:MarkedLineViewModel">
                                    <ContentControl ContentTemplate="{StaticResource MarkedLineCellTemplate}"
                                                    Content="{Binding IndexViewModel}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="markedLines:MarkedLineViewModel">
                                    <textRender:TextView
                                        TextModel="{Binding Text.TextModel, Mode=OneWay}"
                                        FontSize="{DynamicResource LogFontSize}"
                                        textRender:TextView.SharedFoldingState="{Binding Document.FoldingState}"
                                        Tag="{Binding
                                            RelativeSource={RelativeSource FindAncestor,
                                                AncestorType={x:Type listControls:MarkedLinesListView}}}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock FontWeight="Bold"
                                           FontSize="{DynamicResource LogFontSize}"
                                           Text="{Binding Name.Title }" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="{x:Type GroupItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate>
                                            <Expander IsExpanded="True" BorderThickness="0">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBox IsReadOnly="True"
                                                            Text="{Binding Name.Title, Mode=OneWay}" 
                                                            Background="Transparent"
                                                            BorderBrush="Transparent"
                                                            FocusVisualStyle="{x:Null}"
                                                            FontWeight="Bold"
                                                            VerticalAlignment="Center" />
                                                        <ui:Button
                                                            Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type listControls:MarkedLinesListView}},
                                                                    Path=CopyDocumentLinesCommand}"
                                                            CommandParameter="{Binding Name}"
                                                            Margin="10, 0, 0, 0"
                                                            Appearance="Transparent"
                                                            Padding="6,2">
                                                            <StackPanel Orientation="Horizontal">
                                                                <ui:SymbolIcon Margin="0" FontSize="12"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalAlignment="Center"
                                                                    Symbol="Copy24" />
                                                                <TextBlock Margin="6,0,0,0" Text="Copy lines" />
                                                            </StackPanel>
                                                        </ui:Button>
                                                    </StackPanel>
                                                </Expander.Header>
                                                <ItemsPresenter />
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListView.GroupStyle>
            </listControls:MarkedLinesListView>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
