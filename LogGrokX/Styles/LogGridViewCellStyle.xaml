<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:gridView="clr-namespace:LogGrokX.Controls.GridView"
                    xmlns:listControls="clr-namespace:LogGrokX.Controls.ListControls"
                    xmlns:logGrokCore="clr-namespace:LogGrokX"
                    xmlns:textRender="clr-namespace:LogGrokX.Controls.TextRender">
    
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="LogViewContextMenu.xaml"/>
        <ResourceDictionary Source="ToggleButtonStyle.xaml"/>
    </ResourceDictionary.MergedDictionaries>    
    <SolidColorBrush x:Key="Selection" Color="SteelBlue" Opacity="0.5"></SolidColorBrush>
    <SolidColorBrush x:Key="SearchHighlightBrush" Color="#FFE4B5"></SolidColorBrush>
    <SolidColorBrush x:Key="SearchHighlightDarkBrush" Color="#FF6B5300"></SolidColorBrush>
    <Style TargetType="textRender:TextView">
        <Style.Setters>
            <Setter Property="SelectionBrush" Value="{StaticResource Selection}"/>
            <Setter Property="HighlightBrush" Value="{StaticResource SearchHighlightBrush}"/>
            <Setter Property="ContextMenu" Value="{StaticResource LogViewContextMenu}"/>
        </Style.Setters>
        <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.IsDarkTheme,
                         RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                         Value="True">
                <Setter Property="HighlightBrush" Value="{StaticResource SearchHighlightDarkBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <BooleanToVisibilityConverter x:Key="HexToggleVisibilityConverter" />
    <DataTemplate x:Key="NormalTemplate" DataType="{x:Type logGrokCore:LinePartViewModel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <textRender:TextView 
                Grid.Column="0"
                Tag="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type listControls:ListView}}}"
                FontSize="{DynamicResource LogFontSize}"
                TextModel="{Binding TextModel, Mode=OneWay}" />
            <ToggleButton
                Grid.Column="1"
                Margin="4,0,0,0"
                VerticalAlignment="Top"
                Focusable="False"
                Style="{StaticResource SearchOptionToggleButtonStyle}"
                ToolTip="Toggle HEX as text"
                IsChecked="{Binding IsHexDecoded, Mode=TwoWay}"
                Visibility="{Binding IsHexDetected, Converter={StaticResource HexToggleVisibilityConverter}}">
                <TextBlock Text="0x"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </ToggleButton>
        </Grid>
    </DataTemplate>
    <Style TargetType="{x:Type ContentControl}" x:Key="LogGridViewCellStyle">
        <Style.Setters>
            <Setter Property="ContentTemplate" Value="{StaticResource NormalTemplate}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style.Setters>
    </Style>
    <Style TargetType="{x:Type gridView:LogGridViewCell}" BasedOn="{StaticResource LogGridViewCellStyle}"/>
</ResourceDictionary>