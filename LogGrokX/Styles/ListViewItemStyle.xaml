<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:logGrokCore="clr-namespace:LogGrokX"
                    xmlns:controls="clr-namespace:LogGrokX.Controls"
                    xmlns:listControls="clr-namespace:LogGrokX.Controls.ListControls"
                    xmlns:markedLines="clr-namespace:LogGrokX.MarkedLines"
                    xmlns:mergedView="clr-namespace:LogGrokX.MergedView"
                    xmlns:theming="clr-namespace:LogGrokX.Theming"
                    xmlns:gridView="clr-namespace:LogGrokX.Controls.GridView">
    <controls:ObjectToTypeConverter x:Key="ObjectToTypeConverter" />

    <SolidColorBrush x:Key="LogLineSelectionBrush"
                     Color="{DynamicResource SystemAccentColorPrimary}"
                     Opacity="0.35" />
    <SolidColorBrush x:Key="LogLineDefaultDarkForegroundBrush" Color="#FFD2E4F4" />

    <ControlTemplate x:Key="LogLineControlTemplate" 
                     TargetType="{x:Type ListBoxItem}">

        <Grid MinHeight="{TemplateBinding MinHeight}" Margin="-2,0,0,0"
              Background="{TemplateBinding Background}">
            <Border BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    SnapsToDevicePixels="True" />
            <Border x:Name="MarkedOverlay"
                    Background="{DynamicResource SystemFillColorAttentionBrush}"
                    Opacity="0.2"
                    IsHitTestVisible="False"
                    SnapsToDevicePixels="True">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Content.IsMarked,
                                                RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"
                                               Value="True" />
                                    <Condition Binding="{Binding Path=(listControls:BaseLogListViewItem.HighlightMarkedRows),
                                                RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"
                                               Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <GridViewRowPresenter x:Name="RowPresenter"
                                  Margin="2,0,-4,0"
                                  VerticalAlignment="Stretch"
                                  Columns="{TemplateBinding GridView.ColumnCollection}"
                                  Content="{TemplateBinding Content}" />
            <Border x:Name="GroupTopSeparator"
                    Height="1"
                    VerticalAlignment="Top"
                    Background="{TemplateBinding Foreground}"
                    Opacity="0.10"
                    Visibility="Collapsed"
                    SnapsToDevicePixels="True" />
            <Border x:Name="GroupBottomSeparator"
                    Height="1"
                    VerticalAlignment="Bottom"
                    Background="{TemplateBinding Foreground}"
                    Opacity="0.10"
                    Visibility="Collapsed"
                    SnapsToDevicePixels="True" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="listControls:BaseLogListViewItem.IsGroupFirst" Value="True">
                <Setter TargetName="GroupTopSeparator" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="listControls:BaseLogListViewItem.IsGroupLast" Value="True">
                <Setter TargetName="GroupBottomSeparator" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="listControls:BaseLogListViewItem.IsOtherThread" Value="True">
                <Setter TargetName="RowPresenter" Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="LogHeaderControlTemplate" TargetType="{x:Type ListBoxItem}">
        <Grid MinHeight="{TemplateBinding MinHeight}" Margin="-2,0,0,0">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    SnapsToDevicePixels="True" />
            <gridView:LogGridViewCell Content="{Binding Content.Text,
                    RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}}}"
                                      Margin="25, 5, 25, 5"/> 
        </Grid>
    </ControlTemplate>

    <Style x:Key="ItemContainerStyle" TargetType="{x:Type ListViewItem}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self},
                         Converter={StaticResource ObjectToTypeConverter}}"
                         Value="{x:Type logGrokCore:LineViewModel}">
                <Setter Property="Template" Value="{StaticResource LogLineControlTemplate}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self},
                         Converter={StaticResource ObjectToTypeConverter}}"
                         Value="{x:Type markedLines:MarkedLineViewModel}">
                <Setter Property="Template" Value="{StaticResource LogLineControlTemplate}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self},
                         Converter={StaticResource ObjectToTypeConverter}}"
                         Value="{x:Type mergedView:MergedLineViewModel}">
                <Setter Property="Template" Value="{StaticResource LogLineControlTemplate}" />
            </DataTrigger> 
            <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self},
                            Converter={StaticResource ObjectToTypeConverter}}"
                         Value="{x:Type logGrokCore:LogHeaderViewModel}">
                <Setter Property="Template" Value="{StaticResource LogHeaderControlTemplate}" />
            </DataTrigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource LogLineSelectionBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsSelected" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            </MultiTrigger>
            <DataTrigger Binding="{Binding IsDark, Source={x:Static theming:ThemeState.Current}}"
                         Value="True">
                <Setter Property="Foreground" Value="{StaticResource LogLineDefaultDarkForegroundBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LogGridItemContainerStyle" TargetType="{x:Type ListViewItem}"
           BasedOn="{StaticResource ItemContainerStyle}">
        <Setter Property="listControls:BaseLogListViewItem.HighlightMarkedRows" Value="True" />
    </Style>
</ResourceDictionary>
