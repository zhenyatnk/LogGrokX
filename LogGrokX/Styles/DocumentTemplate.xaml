<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:local="clr-namespace:LogGrokX"
                    xmlns:loc="clr-namespace:LogGrokX.Localization"
                    xmlns:controls="clr-namespace:LogGrokX.Controls"
                    xmlns:colors="clr-namespace:LogGrokX.Colors"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    mc:Ignorable="d">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="LogViewTemplate.xaml" />
        <ResourceDictionary Source="DocumentSearchTemplate.xaml" />
    </ResourceDictionary.MergedDictionaries>
    
    <DataTemplate x:Key="DocumentTemplate" DataType="local:DocumentViewModel">
        <controls:RootDocumentControl
            SearchTextCommand="{Binding SearchViewModel.SearchTextCommand}"
            AppendToSearchCommand="{Binding SearchViewModel.AppendToSearchCommand}">
            <controls:RootDocumentControl.InputBindings>
                <KeyBinding Gesture="Ctrl+F" Command="{Binding SearchViewModel.Activate}" />
                <KeyBinding Gesture="Ctrl+L" Command="{Binding SearchViewModel.Activate}" />
                <KeyBinding Gesture="Alt+D" Command="{Binding SearchViewModel.Activate}" />
                <KeyBinding Gesture="Alt+X" Command="{Binding SearchViewModel.ClearSearchCommand}" />
                <KeyBinding Gesture="F3" Command="{Binding FindNextCommand}" />
                <KeyBinding Gesture="Shift+F3" Command="{Binding FindPreviousCommand}" />
            </controls:RootDocumentControl.InputBindings>
            <Grid colors:ColorSettings.ColorSettings="{Binding ColorSettings}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto"/>
                <controls:CollapsibleRow Collapsed="{Binding SearchViewModel.IsFilterDisabled}" 
                                         Height="200"/>
            </Grid.RowDefinitions>                
            
            <ContentControl Grid.Row="0" ContentTemplate="{StaticResource LogViewTemplate}" Content="{Binding LogViewModel}" />

            <GridSplitter Grid.Row="1"
                ResizeBehavior="PreviousAndNext"  
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch"
                Height="10"
                Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                Visibility="{Binding SearchViewModel.IsFilterEnabled,
                            Converter={StaticResource BooleanToVisibilityConverter}}" />
            
            <StackPanel Grid.Row="1" >
                <Border HorizontalAlignment="Stretch" Height="10" />
                <ContentControl ContentTemplate="{StaticResource SearchParametersTemplate}" 
                                Content="{Binding SearchViewModel}"/>
            </StackPanel>
            
            <ContentControl Grid.Row="2" 
                            ContentTemplate="{StaticResource SearchResultsTemplate}" 
                            Content="{Binding SearchViewModel}"
                            Visibility="{Binding SearchViewModel.IsFilterEnabled,
                                Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Border Grid.RowSpan="3"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    Visibility="{Binding IsFileEmpty,
                                Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="72" Height="72" HorizontalAlignment="Center"
                            Style="{StaticResource FluentCardStyle}">
                        <ui:SymbolIcon Symbol="DocumentText24" FontSize="32"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                    </Border>
                    <TextBlock Margin="0,20,0,8" FontSize="24" FontWeight="SemiBold"
                               TextAlignment="Center" Text="{loc:Loc EmptyFileTitle}" />
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Text="{loc:Loc EmptyFileDescription}" />
                    <ui:Button Margin="0,20,0,0" HorizontalAlignment="Center" Appearance="Primary"
                               Command="{Binding DataContext.OpenFileCommand,
                                         RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Content="{loc:Loc OpenLogLabel}" />
                </StackPanel>
            </Border>
        </Grid>
        </controls:RootDocumentControl>
    </DataTemplate>
</ResourceDictionary>