<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:loc="clr-namespace:LogGrokX.Localization"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:local="clr-namespace:LogGrokX"
                    xmlns:localControls="clr-namespace:LogGrokX.Controls"
                    xmlns:listControls="clr-namespace:LogGrokX.Controls.ListControls"
                    xmlns:virtualizingStackPanel1="clr-namespace:LogGrokX.Controls.ListControls.VirtualizingStackPanel"
                    xmlns:textRender="clr-namespace:LogGrokX.Controls.TextRender"
                    mc:Ignorable="d">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="PresentationConverters.xaml" />
        <ResourceDictionary Source="ListViewItemStyle.xaml" />
        <ResourceDictionary Source="LogViewContextMenu.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate x:Key="LogViewTemplate" DataType="local:LogViewModel">
        <Grid localControls:RoutedCommandBehavior.RoutedCommandToCommandBinding= "{localControls:RoutedCommandToCommandBinding 
                RoutedCommand={x:Static local:RoutedCommands.ClearFilters}, 
                Command={Binding ClearFiltersCommand}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0"
                        Margin="4,2,4,2"
                        Orientation="Horizontal"
                        Visibility="{Binding HaveExclusions,
                                    Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding ActiveFilters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2"
                                    Padding="8,2"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="11"
                                               Text="{Binding DisplayText}" />
                                    <ui:Button Margin="4,0,0,0"
                                               Padding="2"
                                               Appearance="Transparent"
                                               Command="{Binding RemoveCommand}"
                                               Content="&#x2715;"
                                               FontSize="10"
                                               ToolTip="{loc:Loc RemoveFilter}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button Margin="4,2,0,2"
                           Padding="8,2"
                           Appearance="Transparent"
                           Command="{Binding ClearExclusionsCommand}"
                           Content="{loc:Loc ClearAll}"
                           FontSize="11"
                           ToolTip="{loc:Loc ClearAllFilters}" />
            </StackPanel>
            <ProgressBar Grid.Row="1"
                         Height="3"
                         HorizontalAlignment="Stretch"
                         Value="{Binding Progress}"
                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <DockPanel Grid.Row="2" LastChildFill="True">
            <localControls:LogMinimapControl DockPanel.Dock="{Binding IsTimelineAtTop, Converter={StaticResource TimelineDockConverter},
                                                               FallbackValue=Bottom}"
                                             Visibility="{Binding IsTimelineVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             Height="30"
                                             HorizontalAlignment="Stretch"
                                             ClipToBounds="True"
                                             ItemCount="{Binding TotalLineCount}"
                                             Markers="{Binding Markers}"
                                             MatchBuckets="{Binding SearchMatches}"
                                             IsRangeEnabled="{Binding TimeRangeFilter.IsAvailable}"
                                             TimeIndex="{Binding TimeRangeFilter.TimeIndex}"
                                             Minimum="{Binding TimeRangeFilter.Minimum,
                                                        Mode=OneWay}"
                                             Maximum="{Binding TimeRangeFilter.Maximum,
                                                        Mode=OneWay}"
                                             LowerValue="{Binding TimeRangeFilter.LowerValue,
                                                          Mode=TwoWay}"
                                             UpperValue="{Binding TimeRangeFilter.UpperValue,
                                                          Mode=TwoWay}"
                                             MinText="{Binding TimeRangeFilter.MinText}"
                                             MaxText="{Binding TimeRangeFilter.MaxText}"
                                             DurationText="{Binding TimeRangeFilter.DurationText}"
                                             UseLineNumbers="{Binding TimeRangeFilter.IsLineNumberMode}"
                                             ScrollPosition="{Binding ScrollPosition}"
                                             ScrollIndicatorBrush="{DynamicResource SystemFillColorSuccessBrush}"
                                             MatchLine="{Binding SearchMatchLine}"
                                             MatchLines="{Binding SearchSelectedLines}"
                                             MatchLineBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                             MarkerBrush="{DynamicResource SystemFillColorCriticalBrush}"
                                             MatchBrush="{DynamicResource SystemFillColorCautionBrush}"
                                             DayBoundaryBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                             MinimapBackground="{DynamicResource ControlFillColorDefaultBrush}"
                                             SelectionBrush="{DynamicResource TimelineSelectionBrush}"
                                             DimBrush="{DynamicResource TimelineDimBrush}"
                                             HandleBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                             DurationForeground="{DynamicResource TextFillColorPrimaryBrush}"
                                             DurationBackground="Transparent"
                                             NavigateCommand="{Binding NavigateToMarkerCommand}" />
            <Grid>
            <listControls:ListView ItemsSource="{Binding Lines}"
                                    Background="{DynamicResource ApplicationBackgroundBrush}"
                                    BorderThickness="0"
                                    SelectionMode="Extended"
                                    ReadonlySelectedItems="{Binding SelectedItems,
                                                            Mode=OneWayToSource}"
                                    View="{Binding CustomView, Converter={StaticResource LogGridViewConverter}}"
                                    ItemContainerStyle="{StaticResource LogGridItemContainerStyle}"
                                    ScrollViewer.VerticalScrollBarVisibility="Visible"
                                    ScrollViewer.CanContentScroll="True"
                                    VirtualizingStackPanel.IsVirtualizing="True"
                                    VirtualizingStackPanel.VirtualizationMode="Recycling"   
                                    localControls:NavigateToLineBehavior.NavigateToLineRequest=
                                        "{Binding NavigateToLineRequest}"
                                    localControls:NavigateToLineBehavior.ChangeCurrentItem="True"
                                    FontFamily="{StaticResource JetBrainsMono}"
                                    FontSize="{DynamicResource LogFontSize}"
                                    IsLoading="{Binding IsLoading}"
                                    ColumnSettings="{Binding ColumnSettings}"
                                    textRender:TextView.SharedFoldingState="{Binding FoldingState}"
                                    x:Name="ItemsListView">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <virtualizingStackPanel1:VirtualizingStackPanel
                            CurrentPosition="{Binding CurrentItemIndex}" 
                            FirstVisibleIndex="{Binding FirstVisibleIndex}"
                            GroupByThread="{Binding GroupByThread}"
                            ShowGroupSeparators="{Binding ShowGroupSeparators}"
                            ThreadFieldIndex="{Binding ThreadFieldIndex}"
                            textRender:TextView.HighlightRegex="{Binding HighlightRegex}"
                            Tag="{Binding 
                                RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type listControls:ListView}}}"
                            ContextMenu="{StaticResource LogViewContextMenu}" 
                            textRender:ClippingRectProviderBehavior.ClippingRectProvider="{Binding RelativeSource={RelativeSource Self}}"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
            </listControls:ListView>
            </Grid>
            </DockPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
