<ui:FluentWindow x:Class="LogGrokX.CallStackWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:loc="clr-namespace:LogGrokX.Localization"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:localControls="clr-namespace:LogGrokX.Controls"
                 xmlns:symbols="clr-namespace:LogGrokX.Symbols"
                 Title="{loc:Loc CallStack}"
                 Width="1000"
                 Height="720"
                 Icon="pack://application:,,,/app.ico"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 FontFamily="{StaticResource AppFontFamily}">
    <Grid UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="80" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MinHeight="80" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <localControls:StableTitleBar Grid.Row="0"
                     Title="{loc:Loc CallStack}">
            <localControls:StableTitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/app.ico" Width="16" Height="16" />
            </localControls:StableTitleBar.Icon>
        </localControls:StableTitleBar>

        <Grid Grid.Row="1" Margin="12,4,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Status}" />
                <TextBlock Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding SymbolPath, Mode=OneWay}"
                           ToolTip="{Binding SymbolPath, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Margin="8,0,0,0" Command="{Binding RefreshCommand}" ToolTip="{loc:Loc ReloadSymbols}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{loc:Loc ReloadSymbols}" />
                    </StackPanel>
                </ui:Button>
                <ui:Button Margin="8,0,0,0" Command="{Binding CopyCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Copy24" FontSize="16" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{loc:Loc CopyCallStack}" />
                    </StackPanel>
                </ui:Button>
            </StackPanel>
        </Grid>

        <ListView Grid.Row="2"
                  Margin="12,0,12,0"
                  ItemsSource="{Binding Frames}"
                  SelectedItem="{Binding SelectedFrame, Mode=TwoWay}"
                  SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="#" Width="40" DisplayMemberBinding="{Binding Number}" />
                    <GridViewColumn Header="{loc:Loc Module}" Width="160" DisplayMemberBinding="{Binding Module}" />
                    <GridViewColumn Header="{loc:Loc Function}" Width="380">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type symbols:CallStackFrameViewModel}">
                                <TextBlock Text="{Binding Function}" ToolTip="{Binding Details}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{loc:Loc SourceLocation}" Width="360">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type symbols:CallStackFrameViewModel}">
                                <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding Location}">
                                    <Hyperlink Command="{Binding DataContext.ShowSourceCommand,
                                                   RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListView}}}"
                                               CommandParameter="{Binding}">
                                        <Run Text="{Binding Location, Mode=OneWay}" />
                                    </Hyperlink>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <Grid Grid.Row="3" Margin="12,8,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding SourcePath, Mode=OneWay}"
                       ToolTip="{Binding SourcePath, Mode=OneWay}" />
            <ui:Button Grid.Column="1"
                       Margin="8,0,0,0"
                       IsEnabled="{Binding HasSourceFile}"
                       Command="{Binding OpenSourceCommand}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Open24" FontSize="16" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{loc:Loc OpenInEditor}" />
                </StackPanel>
            </ui:Button>
        </Grid>

        <Grid Grid.Row="4" Margin="12,0,12,0">
            <ListBox x:Name="SourceList"
                     ItemsSource="{Binding SourceLines}"
                     SelectedItem="{Binding CurrentSourceLine, Mode=OneWay}"
                     FontFamily="Consolas"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Item"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="4,0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type symbols:SourceLineViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="56"
                                       Margin="0,0,12,0"
                                       TextAlignment="Right"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding Number}" />
                            <localControls:SourceCodeTextBlock Code="{Binding Text}" Tokens="{Binding Tokens}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding SourceMessage}" />
        </Grid>

        <ui:Button Grid.Row="5"
                   Margin="12"
                   MinWidth="88"
                   HorizontalAlignment="Right"
                   Appearance="Primary"
                   Click="OnCloseClick"
                   Content="{loc:Loc Close}" />
    </Grid>
</ui:FluentWindow>
