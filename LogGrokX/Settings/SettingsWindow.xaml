<ui:FluentWindow x:Class="LogGrokX.Settings.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:loc="clr-namespace:LogGrokX.Localization"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:localControls="clr-namespace:LogGrokX.Controls"
                 xmlns:settings="clr-namespace:LogGrokX.Settings"
                 Title="{loc:Loc Settings}"
                 Width="860"
                 Height="700"
                 MinWidth="680"
                 MinHeight="480"
                 Icon="pack://application:,,,/app.ico"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 FontFamily="{StaticResource AppFontFamily}"
                 ShowInTaskbar="False">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <DataTemplate x:Key="ProblemTemplate" DataType="{x:Type settings:SettingsProblem}">
            <BulletDecorator Margin="0,1,0,1">
                <BulletDecorator.Bullet>
                    <TextBlock Margin="0,0,6,0" Text="•" />
                </BulletDecorator.Bullet>
                <TextBlock TextWrapping="Wrap">
                    <Hyperlink Click="OnProblemClick"
                               IsEnabled="{Binding CanNavigate, Mode=OneWay}"
                               Foreground="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                               ToolTip="{loc:Loc GoToField}">
                        <Run Text="{Binding Message, Mode=OneWay}" />
                    </Hyperlink>
                </TextBlock>
            </BulletDecorator>
        </DataTemplate>
        <DataTemplate x:Key="AutoFixTemplate" DataType="{x:Type settings:SettingsProblem}">
            <BulletDecorator Margin="0,1,0,1">
                <BulletDecorator.Bullet>
                    <TextBlock Margin="0,0,6,0" Text="•" />
                </BulletDecorator.Bullet>
                <TextBlock TextWrapping="Wrap">
                    <Hyperlink Click="OnAutoFixClick"
                               Foreground="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                               ToolTip="{loc:Loc ApplyFix}">
                        <Run Text="{Binding Message, Mode=OneWay}" />
                    </Hyperlink>
                </TextBlock>
            </BulletDecorator>
        </DataTemplate>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <localControls:StableTitleBar Grid.Row="0" Title="{loc:Loc Settings}">
            <localControls:StableTitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/app.ico" Width="16" Height="16" />
            </localControls:StableTitleBar.Icon>
        </localControls:StableTitleBar>

        <Border Grid.Row="1" Margin="12,4,12,8" Padding="8" Style="{StaticResource FluentCardStyle}">
            <TabControl x:Name="SettingsTabs">
                <TabItem x:Name="ViewTab" Header="{loc:Loc View}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="12" MaxWidth="620" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,12,10"
                                       VerticalAlignment="Center" Text="{loc:Loc Language}" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                <ComboBox ItemsSource="{Binding View.LanguageOptions}"
                                          DisplayMemberPath="Title" SelectedValuePath="Value"
                                          SelectedValue="{Binding View.Language, Mode=TwoWay}" />
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{loc:Loc LanguageRestart}" />
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,12,10"
                                       VerticalAlignment="Center" Text="{loc:Loc AccentColor}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                                      ItemsSource="{Binding View.AccentColorOptions}"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding View.AccentColor, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="16" Height="16" Margin="0,0,8,0"
                                                    CornerRadius="3" Background="{Binding Color, Converter={StaticResource ColorBrushConverter}}" />
                                            <TextBlock VerticalAlignment="Center" Text="{Binding Title}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Margin="0,0,12,10"
                                       VerticalAlignment="Center"
                                       Text="{loc:Loc BigLineHandling}" />
                            <ComboBox Grid.Row="2"
                                      Grid.Column="1"
                                      Margin="0,0,0,10"
                                      ItemsSource="{Binding View.BigLineOptions}"
                                      DisplayMemberPath="Title"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding View.BigLine, Mode=TwoWay}" />

                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Margin="0,0,12,10"
                                       VerticalAlignment="Center"
                                       Text="{loc:Loc BigLineSize}" />
                            <ui:TextBox Grid.Row="3"
                                        Grid.Column="1"
                                        Margin="0,0,0,10"
                                        x:Name="BigLineSizeBox"
                                        Text="{Binding View.BigLineSizeText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />

                            <TextBlock Grid.Row="4"
                                       Grid.Column="0"
                                       Margin="0,0,12,10"
                                       VerticalAlignment="Center"
                                       Text="{loc:Loc LogFontSize}" />
                            <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,10">
                                <TextBlock DockPanel.Dock="Right"
                                           Width="36"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right"
                                           Text="{Binding View.LogFontSizeText}" />
                                <Slider Minimum="6"
                                        Maximum="48"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding View.LogFontSize, Mode=TwoWay}" />
                            </DockPanel>

                            <TextBlock Grid.Row="5"
                                       Grid.Column="0"
                                       Margin="0,0,12,10"
                                       VerticalAlignment="Center"
                                       Text="{loc:Loc TimelineTitle}" />
                            <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,8">
                                <CheckBox Content="{loc:Loc ShowTimeline}" IsChecked="{Binding View.TimelineVisible, Mode=TwoWay}" />
                                <CheckBox Content="{loc:Loc TimelineAtTop}" Margin="0,6,0,0"
                                          IsEnabled="{Binding View.TimelineVisible}"
                                          IsChecked="{Binding View.TimelineAtTop, Mode=TwoWay}" />
                            </StackPanel>

                            <TextBlock Grid.Row="6"
                                       Grid.Column="0"
                                       Margin="0,0,12,10"
                                       VerticalAlignment="Center"
                                       Text="{loc:Loc GroupByThread}" />
                            <CheckBox Grid.Row="6"
                                      Grid.Column="1"
                                      Margin="0,0,0,10"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding View.GroupByThread, Mode=TwoWay}" />

                            <TextBlock Grid.Row="7"
                                       Grid.Column="0"
                                       Margin="0,0,12,10"
                                       VerticalAlignment="Center"
                                       Text="{loc:Loc ShowThreadGroupSeparators}" />
                            <CheckBox Grid.Row="7"
                                      Grid.Column="1"
                                      Margin="0,0,0,10"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding View.ShowThreadGroupSeparators, Mode=TwoWay}" />

                            <TextBlock Grid.Row="8"
                                       Grid.Column="0"
                                       Margin="0,0,12,10"
                                       VerticalAlignment="Center"
                                       Text="{loc:Loc MergedFilesView}" />
                            <CheckBox Grid.Row="8"
                                      Grid.Column="1"
                                      Margin="0,0,0,10"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding View.MergedFilesView, Mode=TwoWay}" />

                            <TextBlock Grid.Row="9"
                                       Grid.Column="0"
                                       Margin="0,0,12,10"
                                       VerticalAlignment="Top"
                                       Text="{loc:Loc BinaryDataDetection}" />
                            <StackPanel Grid.Row="9"
                                        Grid.Column="1"
                                        Margin="0,0,0,10">
                                <CheckBox Content="{loc:Loc DetectBinary}"
                                          IsChecked="{Binding View.DetectBinary, Mode=TwoWay}" />
                                <StackPanel Margin="24,4,0,0"
                                            IsEnabled="{Binding View.DetectBinary}">
                                    <CheckBox Content="{loc:Loc PemDetection}"
                                              IsChecked="{Binding View.DetectPem, Mode=TwoWay}" />
                                    <CheckBox Margin="0,4,0,0"
                                              Content="{loc:Loc Base64Text}"
                                              IsChecked="{Binding View.DetectBase64, Mode=TwoWay}" />
                                    <CheckBox Margin="0,4,0,0"
                                              Content="{loc:Loc HexText}"
                                              IsChecked="{Binding View.DetectHex, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Row="10"
                                       Grid.Column="0"
                                       Margin="0,0,12,10"
                                       VerticalAlignment="Center"
                                       Text="{loc:Loc AutomaticUpdates}" />
                            <ComboBox Grid.Row="10"
                                      Grid.Column="1"
                                      Margin="0,0,0,10"
                                      ItemsSource="{Binding View.UpdateModeOptions}"
                                      DisplayMemberPath="Title"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding View.UpdateMode, Mode=TwoWay}" />

                            <TextBlock Grid.Row="11"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="2"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{loc:Loc ViewHint}" />
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="ProfilesTab" Header="{loc:Loc Profiles}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <WrapPanel>
                          <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                            <ComboBox Width="200" Margin="0,0,12,0"
                                      ItemsSource="{Binding Profiles}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" />
                            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="{loc:Loc Name}" />
                            <ui:TextBox x:Name="ProfileNameBox"
                                        Width="180"
                                        Text="{Binding SelectedProfile.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:Button Command="{Binding AddProfileCommand}" Content="{loc:Loc New}" />
                            <ui:Button Margin="8,0,0,0" Command="{Binding DuplicateProfileCommand}" Content="{loc:Loc Copy}" />
                            <ui:Button Margin="8,0,0,0" Command="{Binding RemoveProfileCommand}" Content="{loc:Loc Remove}" />
                          </StackPanel>
                        </WrapPanel>
                        <TextBlock Grid.Row="1" Margin="0,10,0,8" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{loc:Loc ProfilesHint}" />
                        <TabControl x:Name="ProfileTabs" Grid.Row="2">
                            <TabItem x:Name="ColorsTab" Header="{loc:Loc Colors}">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Margin="0,0,0,8"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{loc:Loc ColorsHint}" />

                                    <DataGrid x:Name="ColorRulesGrid"
                                              Grid.Row="1"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              CanUserReorderColumns="False"
                                              HeadersVisibility="Column"
                                              SelectionMode="Single"
                                              SelectedItem="{Binding SelectedColorRule, Mode=TwoWay}"
                                              ItemsSource="{Binding ColorRules}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Width="*" MinWidth="240"
                                                                Header="{loc:Loc Regex}"
                                                                Binding="{Binding RegexString, UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGridTextColumn Width="150"
                                                                Header="{loc:Loc Foreground}"
                                                                Binding="{Binding ForegroundColor, UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGridTextColumn Width="150"
                                                                Header="{loc:Loc Background}"
                                                                Binding="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGridTemplateColumn Width="90" Header="{loc:Loc Preview}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="2"
                                                                Padding="6,2"
                                                                Background="{Binding BackgroundColor, Converter={StaticResource ColorBrushConverter}}"
                                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="4">
                                                            <TextBlock HorizontalAlignment="Center"
                                                                       Foreground="{Binding ForegroundColor, Converter={StaticResource ColorBrushConverter}}"
                                                                       Text="Aa" />
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel Grid.Row="2" Margin="0,8,0,0" Orientation="Horizontal">
                                        <ui:Button Command="{Binding AddColorRuleCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Add24" FontSize="16" />
                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{loc:Loc AddRule}" />
                                            </StackPanel>
                                        </ui:Button>
                                        <ui:Button Margin="8,0,0,0"
                                                   Command="{Binding RemoveColorRuleCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="16" />
                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{loc:Loc Remove}" />
                                            </StackPanel>
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>
                            </TabItem>

                            <TabItem x:Name="LogFormatsTab" Header="{loc:Loc LogFormats}">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Margin="0,0,0,8"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{loc:Loc FormatsHint}" />

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="LogFormatsList" ItemsSource="{Binding LogFormats}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,10"
                                                            Padding="10"
                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Row="0"
                                                                       Grid.Column="0"
                                                                       Margin="0,0,0,6"
                                                                       FontWeight="SemiBold"
                                                                       Text="{loc:Loc LogFormat}" />

                                                            <TextBlock Grid.Row="0"
                                                                       Grid.Column="1"
                                                                       MaxWidth="350"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                                <Run Text="{loc:Loc FieldsLabel}" />
                                                                <Run Text="{Binding FieldNames, Mode=OneWay}" />
                                                            </TextBlock>

                                                            <ui:TextBox Grid.Row="1"
                                                                        Grid.Column="0"
                                                                        Grid.ColumnSpan="2"
                                                                        MinHeight="52"
                                                                        Margin="0,0,0,8"
                                                                        AcceptsReturn="True"
                                                                        FontFamily="{StaticResource JetBrainsMono}"
                                                                        HorizontalScrollBarVisibility="Auto"
                                                                        Tag="{x:Static settings:SettingsField.LogFormatRegex}"
                                                                        Text="{Binding Regex, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                                        TextWrapping="NoWrap" />

                                                            <TextBlock Grid.Row="2"
                                                                       Grid.Column="0"
                                                                       Grid.ColumnSpan="2"
                                                                       Margin="0,0,0,2"
                                                                       Text="{loc:Loc IndexedFields}" />
                                                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
                                                                <ui:TextBox MinHeight="44"
                                                                            AcceptsReturn="True"
                                                                            FontFamily="{StaticResource JetBrainsMono}"
                                                                            Tag="{x:Static settings:SettingsField.IndexedFields}"
                                                                            Text="{Binding IndexedFields, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                                            TextWrapping="NoWrap" />
                                                                <TextBlock Margin="0,4,0,0"
                                                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                                           Text="{Binding ValidationMessage}"
                                                                           TextWrapping="Wrap"
                                                                           Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVisibility}}" />
                                                            </StackPanel>

                                                            <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="120" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0">
                                                                    <TextBlock Margin="0,0,0,2" Text="{loc:Loc TimeField}" />
                                                                    <ui:TextBox Text="{Binding TimeField, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2">
                                                                    <TextBlock Margin="0,0,0,2" Text="{loc:Loc TimeFormat}" />
                                                                    <ui:TextBox Text="{Binding TimeFormat, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="4">
                                                                    <TextBlock Margin="0,0,0,2" Text="{loc:Loc XorMask}" />
                                                                    <ui:TextBox Tag="{x:Static settings:SettingsField.XorMask}" Text="{Binding XorMask, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                                                </StackPanel>
                                                            </Grid>

                                                            <TextBlock Grid.Row="5"
                                                                       Grid.Column="0"
                                                                       Grid.ColumnSpan="2"
                                                                       Margin="0,8,0,2"
                                                                       Text="{loc:Loc Transformations}" />
                                                            <ui:TextBox Grid.Row="6"
                                                                        Grid.Column="0"
                                                                        Grid.ColumnSpan="2"
                                                                        MinHeight="44"
                                                                        AcceptsReturn="True"
                                                                        FontFamily="{StaticResource JetBrainsMono}"
                                                                        Tag="{x:Static settings:SettingsField.Transformations}"
                                                                        Text="{Binding Transformations, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                                        TextWrapping="NoWrap" />

                                                            <ui:Button Grid.Row="7"
                                                                       Grid.Column="1"
                                                                       Margin="0,8,0,0"
                                                                       HorizontalAlignment="Right"
                                                                       Command="{Binding DataContext.RemoveLogFormatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       CommandParameter="{Binding}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <ui:SymbolIcon Symbol="Delete24" FontSize="16" />
                                                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{loc:Loc Remove}" />
                                                                </StackPanel>
                                                            </ui:Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <StackPanel Grid.Row="2" Margin="0,8,0,0" Orientation="Horizontal">
                                        <ui:Button Command="{Binding AddLogFormatCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Add24" FontSize="16" />
                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{loc:Loc AddFormat}" />
                                            </StackPanel>
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>
                            </TabItem>

                        </TabControl>
                    </Grid>
                </TabItem>

                <TabItem x:Name="ValueMappingsTab" Header="{loc:Loc ValueMappings}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="3"
                                   Margin="0,0,0,8"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{loc:Loc MappingsHint}" />

                        <ListBox Grid.Row="1"
                                 Grid.Column="0"
                                 BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                 BorderThickness="1"
                                 ItemsSource="{Binding ValueMappings}"
                                 SelectedItem="{Binding SelectedValueMapping, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox MinWidth="0"
                                                  Margin="0,0,4,0"
                                                  VerticalAlignment="Center"
                                                  ToolTip="{loc:Loc Enabled}"
                                                  IsChecked="{Binding Enabled, Mode=TwoWay}" />
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Grid.Row="1"
                              Grid.Column="2"
                              DataContext="{Binding SelectedValueMapping}"
                              IsEnabled="{Binding DataContext.HasSelectedValueMapping, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                <TextBlock Margin="0,0,0,2" Text="{loc:Loc Name}" />
                                <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                                <TextBlock Margin="0,0,0,2" Text="{loc:Loc MappingFields}" />
                                <ui:TextBox Text="{Binding Fields, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="3"
                                        Margin="0,0,0,8"
                                        Orientation="Horizontal">
                                <CheckBox Content="{loc:Loc Enabled}" IsChecked="{Binding Enabled, Mode=TwoWay}" />
                                <CheckBox Margin="16,0,0,0"
                                          Content="{loc:Loc IgnoreCase}"
                                          IsChecked="{Binding IgnoreCase, Mode=TwoWay}" />
                            </StackPanel>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="3"
                                       Margin="0,0,0,2"
                                       Text="{loc:Loc Values}" />
                            <DataGrid x:Name="MappingItemsGrid"
                                      Grid.Row="3"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="3"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="True"
                                      CanUserDeleteRows="True"
                                      CanUserReorderColumns="False"
                                      HeadersVisibility="Column"
                                      SelectionMode="Single"
                                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                      ItemsSource="{Binding Items}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="*"
                                                        Header="{loc:Loc Value}"
                                                        Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Width="2*"
                                                        Header="{loc:Loc Mapping}"
                                                        Binding="{Binding Mapping, UpdateSourceTrigger=PropertyChanged}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Row="4"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="3"
                                        Margin="0,8,0,0"
                                        Orientation="Horizontal">
                                <ui:Button Command="{Binding AddItemCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Add24" FontSize="16" />
                                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{loc:Loc AddValue}" />
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button Margin="8,0,0,0" Command="{Binding RemoveItemCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Delete24" FontSize="16" />
                                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{loc:Loc RemoveValue}" />
                                    </StackPanel>
                                </ui:Button>
                            </StackPanel>

                            <Grid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Text="{loc:Loc Preview}" />
                                <ui:TextBox Grid.Column="1"
                                            FontFamily="{StaticResource JetBrainsMono}"
                                            PlaceholderText="{loc:Loc SampleText}"
                                            Text="{Binding SampleText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                <TextBlock Grid.Column="3"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource JetBrainsMono}"
                                           Text="{Binding SamplePreview}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Grid>

                        <StackPanel Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Margin="0,8,0,0"
                                    Orientation="Horizontal">
                            <ui:Button Command="{Binding AddValueMappingCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Add24" FontSize="16" />
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{loc:Loc AddList}" />
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Margin="8,0,0,0" Command="{Binding RemoveValueMappingCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Delete24" FontSize="16" />
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{loc:Loc RemoveList}" />
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Margin="24,0,0,0" Click="OnImportValueMappingsClick">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowImport24" FontSize="16" />
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{loc:Loc ImportJson}" />
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Margin="8,0,0,0"
                                       Click="OnExportValueMappingClick"
                                       IsEnabled="{Binding HasSelectedValueMapping}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowExportLtr24" FontSize="16" />
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{loc:Loc ExportList}" />
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Margin="8,0,0,0" Click="OnExportAllValueMappingsClick">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowExportLtr24" FontSize="16" />
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{loc:Loc ExportAll}" />
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>

                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="3"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding ValueMappingMessage}" />
                    </Grid>
                </TabItem>

                <TabItem Header="{loc:Loc Symbols}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12" MaxWidth="620" HorizontalAlignment="Left">
                            <CheckBox Content="{loc:Loc ResolveCallStacks}"
                                      IsChecked="{Binding Symbols.Enabled, Mode=TwoWay}" />
                            <TextBlock Margin="0,12,0,2" Text="{loc:Loc SymbolPath}" />
                            <ui:TextBox PlaceholderText="srv*C:\Symbols*https://msdl.microsoft.com/download/symbols&#x0a;\\build\symbols"
                                        AcceptsReturn="True"
                                        TextWrapping="NoWrap"
                                        MinLines="3"
                                        MaxHeight="160"
                                        VerticalContentAlignment="Top"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Auto"
                                        Text="{Binding Symbols.SymbolPath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{loc:Loc SymbolPathHint}" />
                            <TextBlock Margin="0,12,0,2" Text="{loc:Loc SourcePath}" />
                            <ui:TextBox PlaceholderText="srv*&#x0a;C:\Sources"
                                        AcceptsReturn="True"
                                        TextWrapping="NoWrap"
                                        MinLines="3"
                                        MaxHeight="160"
                                        VerticalContentAlignment="Top"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Auto"
                                        Text="{Binding Symbols.SourcePath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{loc:Loc SourcePathHint}" />
                            <TextBlock Margin="0,12,0,2" Text="{loc:Loc SymbolCachePath}" />
                            <ui:TextBox PlaceholderText="%LOCALAPPDATA%\LogGrokX\Symbols"
                                        Text="{Binding Symbols.CachePath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            <CheckBox Margin="0,12,0,0"
                                      Content="{loc:Loc AllowSourceServerCommands}"
                                      IsChecked="{Binding Symbols.AllowSourceServerCommands, Mode=TwoWay}" />
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{loc:Loc AllowSourceServerCommandsHint}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="DebugTab" Header="{loc:Loc Debug}">
                    <StackPanel Margin="12" MaxWidth="620" HorizontalAlignment="Left">
                        <CheckBox VerticalAlignment="Center"
                                  Content="{loc:Loc EnableCrashDumps}"
                                  IsChecked="{Binding Debug.EnableCrashDumps, Mode=TwoWay}" />
                        <TextBlock Margin="0,10,0,2" Text="{loc:Loc MaxDumpsCount}" />
                        <ui:TextBox x:Name="MaxDumpsCountBox"
                                    MaxWidth="200"
                                    HorizontalAlignment="Left"
                                    Text="{Binding Debug.MaxDumpsCountText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        <TextBlock Margin="0,12,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{loc:Loc DebugHint}" />
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Border>

        <ui:InfoBar Grid.Row="2"
                    Margin="12,0,12,0"
                    HorizontalAlignment="Stretch"
                    IsClosable="False"
                    IsOpen="{Binding RequiresRestart, Mode=OneWay}"
                    Message="{loc:Loc RestartHint}"
                    Severity="Warning"
                    Title="{loc:Loc RestartRequired}" />

        <Grid Grid.Row="3" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <ui:Button HorizontalAlignment="Left" Command="{Binding OpenFileCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="DocumentText24" FontSize="16" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{loc:Loc OpenSettingsFile}" />
                    </StackPanel>
                </ui:Button>
                <TextBlock Margin="0,4,0,0"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           Text="{Binding ValidationMessage}"
                           TextWrapping="Wrap"
                           Visibility="{Binding ShowValidationText, Converter={StaticResource BoolToVisibility}}" />
                <ScrollViewer Margin="0,4,0,0"
                              MaxHeight="120"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Problems}"
                                  ItemTemplate="{StaticResource ProblemTemplate}"
                                  TextElement.Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                </ScrollViewer>
                <StackPanel Margin="0,8,0,0"
                            Visibility="{Binding HasAutoFixes, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Margin="0,0,0,2" FontWeight="SemiBold" Text="{loc:Loc AutoFixAvailable}" />
                    <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AutoFixes}" ItemTemplate="{StaticResource AutoFixTemplate}" />
                    </ScrollViewer>
                    <ui:Button Margin="0,6,0,0"
                               HorizontalAlignment="Left"
                               Click="OnFixAndSaveClick">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Wrench24" FontSize="16" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{loc:Loc FixAndSave}" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </StackPanel>

            <ui:Button Grid.Column="1"
                       Margin="0,0,8,0"
                       VerticalAlignment="Bottom"
                       Click="OnCancelClick"
                       Content="{loc:Loc Cancel}" />
            <ui:Button Grid.Column="2"
                       VerticalAlignment="Bottom"
                       Appearance="Primary"
                       Click="OnSaveClick"
                       Content="{loc:Loc Save}" />
            <TextBlock Grid.Column="3" Width="1" />
        </Grid>
    </Grid>
</ui:FluentWindow>
