<ui:FluentWindow x:Class="LogGrokX.Settings.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Settings"
                 Width="860"
                 Height="700"
                 MinWidth="680"
                 MinHeight="480"
                 Icon="pack://application:,,,/app.ico"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Settings">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/app.ico" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <TabControl Grid.Row="1" Margin="12,4,12,0">
            <TabItem Header="View">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12" MaxWidth="620" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Margin="0,0,12,10"
                                   VerticalAlignment="Center"
                                   Text="Big line handling" />
                        <ComboBox Grid.Row="0"
                                  Grid.Column="1"
                                  Margin="0,0,0,10"
                                  ItemsSource="{Binding View.BigLineOptions}"
                                  SelectedItem="{Binding View.BigLine, Mode=TwoWay}" />

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Margin="0,0,12,10"
                                   VerticalAlignment="Center"
                                   Text="Big line size" />
                        <ui:TextBox Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,0,0,10"
                                    Text="{Binding View.BigLineSizeText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Margin="0,0,12,10"
                                   VerticalAlignment="Center"
                                   Text="Log font size" />
                        <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Right"
                                       Width="36"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       Text="{Binding View.LogFontSizeText}" />
                            <Slider Minimum="6"
                                    Maximum="48"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding View.LogFontSize, Mode=TwoWay}" />
                        </DockPanel>

                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Margin="0,0,12,10"
                                   VerticalAlignment="Center"
                                   Text="Timeline at top" />
                        <CheckBox Grid.Row="3"
                                  Grid.Column="1"
                                  Margin="0,0,0,10"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding View.TimelineAtTop, Mode=TwoWay}" />

                        <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   Margin="0,0,12,10"
                                   VerticalAlignment="Center"
                                   Text="Group by thread" />
                        <CheckBox Grid.Row="4"
                                  Grid.Column="1"
                                  Margin="0,0,0,10"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding View.GroupByThread, Mode=TwoWay}" />

                        <TextBlock Grid.Row="5"
                                   Grid.Column="0"
                                   Margin="0,0,12,10"
                                   VerticalAlignment="Center"
                                   Text="Show thread group separators" />
                        <CheckBox Grid.Row="5"
                                  Grid.Column="1"
                                  Margin="0,0,0,10"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding View.ShowThreadGroupSeparators, Mode=TwoWay}" />

                        <TextBlock Grid.Row="6"
                                   Grid.Column="0"
                                   Margin="0,0,12,10"
                                   VerticalAlignment="Center"
                                   Text="Merged files view" />
                        <CheckBox Grid.Row="6"
                                  Grid.Column="1"
                                  Margin="0,0,0,10"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding View.MergedFilesView, Mode=TwoWay}" />

                        <TextBlock Grid.Row="7"
                                   Grid.Column="0"
                                   Margin="0,0,12,10"
                                   VerticalAlignment="Top"
                                   Text="Binary data detection" />
                        <StackPanel Grid.Row="7"
                                    Grid.Column="1"
                                    Margin="0,0,0,10">
                            <CheckBox Content="Detect binary data (BIN)"
                                      IsChecked="{Binding View.DetectBinary, Mode=TwoWay}" />
                            <StackPanel Margin="24,4,0,0"
                                        IsEnabled="{Binding View.DetectBinary}">
                                <CheckBox Content="PEM blocks, certificates and keys"
                                          IsChecked="{Binding View.DetectPem, Mode=TwoWay}" />
                                <CheckBox Margin="0,4,0,0"
                                          Content="Base64 text"
                                          IsChecked="{Binding View.DetectBase64, Mode=TwoWay}" />
                                <CheckBox Margin="0,4,0,0"
                                          Content="HEX"
                                          IsChecked="{Binding View.DetectHex, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Row="8"
                                   Grid.Column="0"
                                   Margin="0,0,12,10"
                                   VerticalAlignment="Center"
                                   Text="Automatic updates" />
                        <ComboBox Grid.Row="8"
                                  Grid.Column="1"
                                  Margin="0,0,0,10"
                                  ItemsSource="{Binding View.UpdateModeOptions}"
                                  DisplayMemberPath="Title"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding View.UpdateMode, Mode=TwoWay}" />

                        <TextBlock Grid.Row="9"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Big line handling and grouping are applied when a log file is opened. Binary data detection and value mappings apply to lines shown after saving; reopen the log to apply them to every line. Timeline placement, grouping toggle, merged files view and font size apply immediately." />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Colors">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Lines matching a rule are colored. Use a color name or #AARRGGBB. The first matching rule wins." />

                    <DataGrid x:Name="ColorRulesGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              SelectedItem="{Binding SelectedColorRule, Mode=TwoWay}"
                              ItemsSource="{Binding ColorRules}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*"
                                                Header="Regex"
                                                Binding="{Binding RegexString, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Width="150"
                                                Header="Foreground"
                                                Binding="{Binding ForegroundColor, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Width="150"
                                                Header="Background"
                                                Binding="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTemplateColumn Width="90" Header="Preview">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Margin="2"
                                                Padding="6,2"
                                                Background="{Binding BackgroundBrush}"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <TextBlock HorizontalAlignment="Center"
                                                       Foreground="{Binding ForegroundBrush}"
                                                       Text="Aa" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Margin="0,8,0,0" Orientation="Horizontal">
                        <ui:Button Command="{Binding AddColorRuleCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" FontSize="16" />
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Add rule" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Margin="8,0,0,0"
                                   Command="{Binding RemoveColorRuleCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Delete24" FontSize="16" />
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Remove" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Log formats">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Formats are tried in order when a log file is opened. Indexed fields and transformations are edited one entry per line." />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding LogFormats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10"
                                            Padding="10"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0"
                                                       Grid.Column="0"
                                                       Margin="0,0,0,6"
                                                       FontWeight="SemiBold"
                                                       Text="Log format" />

                                            <TextBlock Grid.Row="0"
                                                       Grid.Column="1"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                <Run Text="Fields:" />
                                                <Run Text="{Binding FieldNames, Mode=OneWay}" />
                                            </TextBlock>

                                            <ui:TextBox Grid.Row="1"
                                                        Grid.Column="0"
                                                        Grid.ColumnSpan="2"
                                                        MinHeight="52"
                                                        Margin="0,0,0,8"
                                                        AcceptsReturn="True"
                                                        FontFamily="{StaticResource JetBrainsMono}"
                                                        HorizontalScrollBarVisibility="Auto"
                                                        Text="{Binding Regex, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                        TextWrapping="NoWrap" />

                                            <TextBlock Grid.Row="2"
                                                       Grid.Column="0"
                                                       Grid.ColumnSpan="2"
                                                       Margin="0,0,0,2"
                                                       Text="Indexed fields (one per line)" />
                                            <ui:TextBox Grid.Row="3"
                                                        Grid.Column="0"
                                                        Grid.ColumnSpan="2"
                                                        MinHeight="44"
                                                        Margin="0,0,0,8"
                                                        AcceptsReturn="True"
                                                        FontFamily="{StaticResource JetBrainsMono}"
                                                        Text="{Binding IndexedFields, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                        TextWrapping="NoWrap" />

                                            <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Margin="0,0,0,2" Text="Time field" />
                                                    <ui:TextBox Text="{Binding TimeField, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Margin="0,0,0,2" Text="Time format" />
                                                    <ui:TextBox Text="{Binding TimeFormat, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Margin="0,0,0,2" Text="XOR mask" />
                                                    <ui:TextBox Text="{Binding XorMask, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Grid.Row="5"
                                                       Grid.Column="0"
                                                       Grid.ColumnSpan="2"
                                                       Margin="0,8,0,2"
                                                       Text="Transformations (one per line)" />
                                            <ui:TextBox Grid.Row="6"
                                                        Grid.Column="0"
                                                        Grid.ColumnSpan="2"
                                                        MinHeight="44"
                                                        AcceptsReturn="True"
                                                        FontFamily="{StaticResource JetBrainsMono}"
                                                        Text="{Binding Transformations, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                        TextWrapping="NoWrap" />

                                            <ui:Button Grid.Row="7"
                                                       Grid.Column="1"
                                                       Margin="0,8,0,0"
                                                       HorizontalAlignment="Right"
                                                       Command="{Binding DataContext.RemoveLogFormatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Delete24" FontSize="16" />
                                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Remove" />
                                                </StackPanel>
                                            </ui:Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,8,0,0" Orientation="Horizontal">
                        <ui:Button Command="{Binding AddLogFormatCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" FontSize="16" />
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Add format" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Value mappings">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Grid.ColumnSpan="3"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Values found in the listed fields are shown as value(mapping), for example 0x00001(type 1). Leave Fields empty to apply a list to every field. Lists are imported and exported as JSON." />

                    <ListBox Grid.Row="1"
                             Grid.Column="0"
                             BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                             BorderThickness="1"
                             ItemsSource="{Binding ValueMappings}"
                             SelectedItem="{Binding SelectedValueMapping, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox MinWidth="0"
                                              Margin="0,0,4,0"
                                              VerticalAlignment="Center"
                                              ToolTip="Enabled"
                                              IsChecked="{Binding Enabled, Mode=TwoWay}" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="1"
                          Grid.Column="2"
                          DataContext="{Binding SelectedValueMapping}"
                          IsEnabled="{Binding DataContext.HasSelectedValueMapping, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                            <TextBlock Margin="0,0,0,2" Text="Name" />
                            <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                            <TextBlock Margin="0,0,0,2" Text="Fields (comma separated, empty = all fields)" />
                            <ui:TextBox Text="{Binding Fields, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Margin="0,0,0,8"
                                    Orientation="Horizontal">
                            <CheckBox Content="Enabled" IsChecked="{Binding Enabled, Mode=TwoWay}" />
                            <CheckBox Margin="16,0,0,0"
                                      Content="Ignore case"
                                      IsChecked="{Binding IgnoreCase, Mode=TwoWay}" />
                        </StackPanel>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="3"
                                   Margin="0,0,0,2"
                                   Text="Values" />
                        <DataGrid Grid.Row="3"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="3"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="True"
                                  CanUserDeleteRows="True"
                                  CanUserReorderColumns="False"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                  ItemsSource="{Binding Items}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="*"
                                                    Header="Value"
                                                    Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Width="2*"
                                                    Header="Mapping"
                                                    Binding="{Binding Mapping, UpdateSourceTrigger=PropertyChanged}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="4"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Margin="0,8,0,0"
                                    Orientation="Horizontal">
                            <ui:Button Command="{Binding AddItemCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Add24" FontSize="16" />
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Add value" />
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Margin="8,0,0,0" Command="{Binding RemoveItemCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Delete24" FontSize="16" />
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Remove value" />
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>

                        <Grid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Text="Preview" />
                            <ui:TextBox Grid.Column="1"
                                        FontFamily="{StaticResource JetBrainsMono}"
                                        PlaceholderText="Sample text"
                                        Text="{Binding SampleText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            <TextBlock Grid.Column="3"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource JetBrainsMono}"
                                       Text="{Binding SamplePreview}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Margin="0,8,0,0"
                                Orientation="Horizontal">
                        <ui:Button Command="{Binding AddValueMappingCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" FontSize="16" />
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Add list" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Margin="8,0,0,0" Command="{Binding RemoveValueMappingCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Delete24" FontSize="16" />
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Remove list" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Margin="24,0,0,0" Click="OnImportValueMappingsClick">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowImport24" FontSize="16" />
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Import JSON..." />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Margin="8,0,0,0"
                                   Click="OnExportValueMappingClick"
                                   IsEnabled="{Binding HasSelectedValueMapping}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowExportLtr24" FontSize="16" />
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Export list..." />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Margin="8,0,0,0" Click="OnExportAllValueMappingsClick">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowExportLtr24" FontSize="16" />
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Export all..." />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>

                    <TextBlock Grid.Row="3"
                               Grid.Column="0"
                               Grid.ColumnSpan="3"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding ValueMappingMessage}" />
                </Grid>
            </TabItem>

            <TabItem Header="Debug">
                <StackPanel Margin="12" MaxWidth="620" HorizontalAlignment="Left">
                    <CheckBox VerticalAlignment="Center"
                              Content="Enable crash dumps"
                              IsChecked="{Binding Debug.EnableCrashDumps, Mode=TwoWay}" />
                    <TextBlock Margin="0,10,0,2" Text="Max dumps count" />
                    <ui:TextBox MaxWidth="200"
                                HorizontalAlignment="Left"
                                Text="{Binding Debug.MaxDumpsCountText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    <TextBlock Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Debug settings are applied on the next start of the application." />
                </StackPanel>
            </TabItem>
        </TabControl>

        <ui:InfoBar Grid.Row="2"
                    Margin="12,0,12,0"
                    HorizontalAlignment="Stretch"
                    IsClosable="False"
                    IsOpen="{Binding RequiresRestart, Mode=OneWay}"
                    Message="Restart the application (or reopen the log) to apply these settings."
                    Severity="Warning"
                    Title="Restart required" />

        <Grid Grid.Row="3" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <ui:Button HorizontalAlignment="Left" Command="{Binding OpenFileCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="DocumentText24" FontSize="16" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Open appsettings.yaml" />
                    </StackPanel>
                </ui:Button>
                <TextBlock Margin="0,4,0,0"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           Text="{Binding ValidationMessage}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <ui:Button Grid.Column="1"
                       Margin="0,0,8,0"
                       VerticalAlignment="Bottom"
                       Click="OnCancelClick"
                       Content="Cancel" />
            <ui:Button Grid.Column="2"
                       VerticalAlignment="Bottom"
                       Appearance="Primary"
                       Click="OnSaveClick"
                       Content="Save" />
            <TextBlock Grid.Column="3" Width="1" />
        </Grid>
    </Grid>
</ui:FluentWindow>