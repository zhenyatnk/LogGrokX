<ui:FluentWindow x:Class="LogGrokX.MainWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:loc="clr-namespace:LogGrokX.Localization"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                xmlns:localControls="clr-namespace:LogGrokX.Controls"
                xmlns:local="clr-namespace:LogGrokX"
                xmlns:avalonDockExtensions="clr-namespace:LogGrokX.AvalonDockExtensions"
                d:DataContext="{d:DesignInstance Type=local:MainWindowViewModel, IsDesignTimeCreatable=False}"
                localControls:DragnDropBehavior.AllowDrop="True"
                localControls:DragnDropBehavior.DropCommand="{Binding DropCommand}"
                ExtendsContentIntoTitleBar="True"
                WindowBackdropType="None"
                WindowCornerPreference="Round"
                Icon="pack://application:,,,/app.ico"
                WindowStartupLocation="CenterScreen"
                MinWidth="1024"
                MinHeight="640"
                Width="1360"
                Height="860"
                mc:Ignorable="d"
                Title="{Binding WindowTitle}">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/DocumentTemplate.xaml" />
                <ResourceDictionary Source="Styles/MarkedLinesViewTemplate.xaml" />
                <ResourceDictionary Source="Styles/MergedViewTemplate.xaml" />
                <ResourceDictionary Source="Styles/ListViewItemStyle.xaml" />
                <ResourceDictionary Source="Styles/LayoutItemStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <avalonDockExtensions:MenuItemCollection x:Key="AdditionalDocumentMenuItems">
                <MenuItem Header="{loc:Loc CopyFilename}" Command="{Binding Model.Content.CopyFilenameToClipboardCommand}" />
                <MenuItem Header="{loc:Loc CopyFullPath}" Command="{Binding Model.Content.CopyPathToClipboardCommand}" />
                <MenuItem Header="{loc:Loc OpenContainingFolder}" Command="{Binding Model.Content.OpenContainingFolderCommand}" />
            </avalonDockExtensions:MenuItemCollection>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <ui:FluentWindow.InputBindings>
        <KeyBinding Command="{Binding OpenFileCommand}" Gesture="CTRL+O" />
        <KeyBinding Command="{Binding ZoomInCommand}" Gesture="CTRL+OemPlus" />
        <KeyBinding Command="{Binding ZoomInCommand}" Gesture="CTRL+SHIFT+OemPlus" />
        <KeyBinding Command="{Binding ZoomOutCommand}" Gesture="CTRL+OemMinus" />
        <KeyBinding Command="{Binding ResetZoomCommand}" Gesture="CTRL+D0" />
    </ui:FluentWindow.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding WindowTitle}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/app.ico" Width="16" Height="16" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox Width="150" Margin="4,0,8,0" VerticalAlignment="Center"
                              ItemsSource="{Binding Profiles}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                              ToolTip="{loc:Loc ProfileHint}" />
                    <ui:Button Appearance="Transparent"
                               ToolTip="{loc:Loc OpenLogFile}"
                               Command="{Binding OpenFileCommand}">
                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" />
                    </ui:Button>
                    <ui:Button Appearance="Transparent"
                               ToolTip="{loc:Loc IncreaseTextSize}"
                               Command="{Binding ZoomInCommand}">
                        <ui:SymbolIcon Symbol="ZoomIn24" FontSize="16" />
                    </ui:Button>
                    <ui:Button Appearance="Transparent"
                               ToolTip="{loc:Loc DecreaseTextSize}"
                               Command="{Binding ZoomOutCommand}">
                        <ui:SymbolIcon Symbol="ZoomOut24" FontSize="16" />
                    </ui:Button>
                    <ui:Button Appearance="Transparent"
                               ToolTip="{loc:Loc ResetTextSize}"
                               Command="{Binding ResetZoomCommand}">
                        <ui:SymbolIcon Symbol="ZoomFit24" FontSize="16" />
                    </ui:Button>
                    <ui:Button Appearance="Transparent"
                               ToolTip="{loc:Loc ToggleTheme}"
                               Command="{Binding ToggleThemeCommand}">
                        <ui:SymbolIcon FontSize="16">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="{x:Type ui:SymbolIcon}">
                                    <Setter Property="Symbol" Value="WeatherSunny24" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                            <Setter Property="Symbol" Value="WeatherMoon24" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </ui:Button>
                    <ToggleButton Margin="4,0"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding IsTimelineAtTop, Mode=TwoWay}"
                                  ToolTip="{loc:Loc TimelinePlacement}">
                        <ui:SymbolIcon Symbol="ArrowSort24" FontSize="16" />
                    </ToggleButton>
                    <ToggleButton Margin="4,0"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding IsGroupByThread, Mode=TwoWay}"
                                  ToolTip="{loc:Loc ThreadGrouping}">
                        <ui:SymbolIcon Symbol="GroupList24" FontSize="16" />
                    </ToggleButton>
                    <ToggleButton Margin="4,0"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding IsMergedView, Mode=TwoWay}"
                                  ToolTip="{loc:Loc MergeFiles}">
                        <ui:SymbolIcon Symbol="Merge24" FontSize="16" />
                    </ToggleButton>
                    <ui:Button Appearance="Transparent"
                               ToolTip="{loc:Loc Support}"
                               Command="{Binding OpenSupportCommand}">
                        <ui:SymbolIcon Symbol="QuestionCircle24" FontSize="16" />
                    </ui:Button>
                    <ui:Button Appearance="Transparent"
                               ToolTip="{loc:Loc OpenSettings}"
                               Command="{Binding OpenSettings}">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="16" />
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <DockingManager x:Name="DockingManager"
                        Grid.Row="1"
                        Theme="{Binding DockTheme}"
                        GridSplitterWidth="10"
                        GridSplitterHeight="10"
                        LayoutItemContainerStyleSelector="{StaticResource DocumentLayoutItemStyleSelector}"
                        avalonDockExtensions:BindingBehavior.CurrentDocument="{Binding CurrentDocument}"
                        avalonDockExtensions:BindingBehavior.DocumentViewTemplate="{StaticResource DocumentTemplate}"
                        avalonDockExtensions:BindingBehavior.DocumentsSource="{Binding Documents}"
                        avalonDockExtensions:BindingBehavior.OnDocumentCloseCommand="{Binding OnDocumentCloseCommand}"
                        avalonDockExtensions:DocumentContextMenu.AdditionalContextMenuItems="{StaticResource AdditionalDocumentMenuItems}">
        </DockingManager>
    </Grid>
</ui:FluentWindow>
