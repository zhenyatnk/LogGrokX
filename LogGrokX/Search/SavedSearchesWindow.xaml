<ui:FluentWindow x:Class="LogGrokX.Search.SavedSearchesWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:LogGrokX.Localization"
                 xmlns:controls="clr-namespace:LogGrokX.Controls"
                 xmlns:search="clr-namespace:LogGrokX.Search"
                 Title="{loc:Loc SavedSearches}"
                 Width="900"
                 Height="480"
                 MinWidth="640"
                 MinHeight="400"
                 Icon="pack://application:,,,/LogGrokX;component/app.ico"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 FontFamily="{StaticResource AppFontFamily}"
                 ShowInTaskbar="False">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <Style x:Key="ActionButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,5" />
        </Style>
    </ui:FluentWindow.Resources>
    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddCommand}" />
    </ui:FluentWindow.InputBindings>
    <Grid UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:StableTitleBar Grid.Row="0"
                                 Title="{loc:Loc SavedSearches}"
                                 ShowMinimize="False"
                                 ShowMaximize="False">
            <controls:StableTitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/LogGrokX;component/app.ico" Width="16" Height="16" />
            </controls:StableTitleBar.Icon>
        </controls:StableTitleBar>

        <Grid Grid.Row="1" Margin="16,6,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="220" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="7*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0"
                            Margin="0,0,6,0"
                            Text="{Binding SavedSearchFilter, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="{loc:Loc FilterSavedSearches}" />
                <ui:Button Grid.Column="1"
                           Width="28"
                           MinHeight="30"
                           Margin="0,0,2,0"
                           Padding="0"
                           Appearance="Transparent"
                           Command="{Binding AddCommand}"
                           ToolTip="{loc:Loc NewSearch}">
                    <ui:SymbolIcon Symbol="Add24" FontSize="15" />
                </ui:Button>
                <ui:Button Grid.Column="2"
                           Width="28"
                           MinHeight="30"
                           Margin="0,0,2,0"
                           Padding="0"
                           Appearance="Transparent"
                           Command="{Binding DuplicateCommand}"
                           IsEnabled="{Binding CanDuplicate}"
                           ToolTip="{loc:Loc Duplicate}">
                    <ui:SymbolIcon Symbol="Copy24" FontSize="15" />
                </ui:Button>
                <ui:Button Grid.Column="3"
                           Width="28"
                           MinHeight="30"
                           Padding="0"
                           Appearance="Transparent"
                           Command="{Binding DeleteCommand}"
                           IsEnabled="{Binding HasSelectedSearch}">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="ToolTip" Value="{loc:Loc Delete}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelectedSearchDeleted}" Value="True">
                                    <Setter Property="ToolTip" Value="{loc:Loc RestoreSavedSearch}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                    <ui:SymbolIcon FontSize="15">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol" Value="Delete24" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelectedSearchDeleted}" Value="True">
                                        <Setter Property="Symbol" Value="ArrowUndo24" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                </ui:Button>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="0">
                <ListBox x:Name="SavedSearchesList"
                         Padding="2"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectedItem="{Binding SelectedSearch, Mode=OneWay}"
                         SelectionChanged="OnSavedSearchSelectionChanged">
                    <ListBox.InputBindings>
                        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
                    </ListBox.InputBindings>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPendingDeletion}" Value="True">
                                    <Setter Property="Opacity" Value="0.45" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.Resources>
                        <controls:SavedSearchCollectionViewSource x:Key="FilteredSavedSearches"
                            Source="{Binding SavedSearches}" FilterText="{Binding SavedSearchFilter}" />
                    </ListBox.Resources>
                    <ListBox.ItemsSource>
                        <Binding Source="{StaticResource FilteredSavedSearches}" />
                    </ListBox.ItemsSource>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type search:SavedSearchPattern}">
                            <Grid Margin="4,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           FontSize="12"
                                           LineHeight="14"
                                           LineStackingStrategy="BlockLineHeight"
                                           Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Name}" />
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           FontFamily="{StaticResource JetBrainsMono}"
                                           FontSize="11"
                                           LineHeight="13"
                                           LineStackingStrategy="BlockLineHeight"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Pattern}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Pattern}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                           Margin="8,0,6,0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="Aa"
                                           ToolTip="{loc:Loc MatchCase}"
                                           Visibility="{Binding IsCaseSensitive, Converter={StaticResource BooleanToVisibility}}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Grid.RowSpan="2"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="(.*)"
                                           ToolTip="{loc:Loc UseRegex}"
                                           Visibility="{Binding UseRegex, Converter={StaticResource BooleanToVisibility}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Margin="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=SavedSearchesList, Path=HasItems}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{loc:Loc NoSavedSearchesFound}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <ui:Button Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource ActionButtonStyle}"
                               Command="{Binding AddCommand}"
                               Content="{loc:Loc NewSearch}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="2">
                <ScrollViewer Visibility="{Binding HasEditor, Converter={StaticResource BooleanToVisibility}}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{loc:Loc SavedSearchPendingDeletion}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding IsSelectedSearchDeleted, Converter={StaticResource BooleanToVisibility}}" />
                        <StackPanel IsEnabled="{Binding CanEdit}">
                            <TextBlock Margin="0,0,0,4"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{loc:Loc Name}" />
                            <ui:TextBox x:Name="EditNameBox" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,10,0,4"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{loc:Loc Pattern}" />
                            <ui:TextBox MinHeight="72"
                                        AcceptsReturn="True"
                                        FontFamily="{StaticResource JetBrainsMono}"
                                        Text="{Binding EditPattern, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Auto" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       Text="{Binding ValidationMessage}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasValidationMessage, Converter={StaticResource BooleanToVisibility}}" />
                            <WrapPanel Margin="0,8,0,0">
                                <CheckBox Margin="0,0,16,0"
                                          Content="{loc:Loc MatchCase}"
                                          IsChecked="{Binding EditIsCaseSensitive}" />
                                <CheckBox Content="{loc:Loc UseRegex}"
                                          IsChecked="{Binding EditUseRegex}" />
                            </WrapPanel>
                            <Border Margin="0,8,0,0"
                                    Padding="8,6"
                                    CornerRadius="4"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    Visibility="{Binding IsReplaceConfirmationVisible, Converter={StaticResource BooleanToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc ReplaceSavedSearchConfirmation}" TextWrapping="Wrap" />
                                    <WrapPanel Margin="0,6,0,0">
                                        <ui:Button Margin="0,0,6,0"
                                                   Style="{StaticResource ActionButtonStyle}"
                                                   Appearance="Primary"
                                                   Command="{Binding ConfirmReplaceCommand}"
                                                   Content="{loc:Loc Replace}" />
                                        <ui:Button Style="{StaticResource ActionButtonStyle}"
                                                   Command="{Binding CancelReplaceCommand}" Content="{loc:Loc Cancel}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Margin="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{loc:Loc SelectSavedSearch}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasNoEditor, Converter={StaticResource BooleanToVisibility}}" />
            </Grid>

            <WrapPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                       Margin="0,12,0,0"
                       HorizontalAlignment="Right"
                       Visibility="{Binding ShowActions, Converter={StaticResource BooleanToVisibility}}">
                <ui:Button Margin="0,0,8,0"
                           Style="{StaticResource ActionButtonStyle}"
                           Command="{Binding CancelEditCommand}"
                           IsEnabled="{Binding CanCancelEdit}"
                           Content="{loc:Loc Cancel}" />
                <ui:Button Appearance="Primary"
                           Style="{StaticResource ActionButtonStyle}"
                           Command="{Binding SaveCommand}"
                           IsEnabled="{Binding CanSave}"
                           Content="{loc:Loc Save}" />
            </WrapPanel>
        </Grid>

        <ui:Button Grid.Row="1"
                   Width="0"
                   Height="0"
                   Padding="0"
                   BorderThickness="0"
                   Visibility="Collapsed"
                   IsCancel="True"
                   Focusable="False"
                   Click="OnCloseClick" />
    </Grid>
</ui:FluentWindow>
