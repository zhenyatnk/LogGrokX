<ui:FluentWindow x:Class="LogGrokX.Search.SavedSearchesWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:LogGrokX.Localization"
                 xmlns:controls="clr-namespace:LogGrokX.Controls"
                 xmlns:search="clr-namespace:LogGrokX.Search"
                 Title="{loc:Loc SavedSearches}"
                 Width="900"
                 Height="480"
                 MinWidth="640"
                 MinHeight="400"
                 Icon="pack://application:,,,/LogGrokX;component/app.ico"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 FontFamily="{StaticResource AppFontFamily}"
                 ShowInTaskbar="False">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </ui:FluentWindow.Resources>
    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
    </ui:FluentWindow.InputBindings>
    <Grid UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:StableTitleBar Grid.Row="0"
                                 Title="{loc:Loc SavedSearches}"
                                 ShowMinimize="False"
                                 ShowMaximize="False">
            <controls:StableTitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/LogGrokX;component/app.ico" Width="16" Height="16" />
            </controls:StableTitleBar.Icon>
        </controls:StableTitleBar>

        <Grid Grid.Row="1" Margin="16,6,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="220" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="7*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0"
                            Margin="0,0,6,0"
                            Text="{Binding SavedSearchFilter, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="{loc:Loc FilterSavedSearches}" />
                <ui:Button Grid.Column="1"
                           Width="28"
                           MinHeight="30"
                           Margin="0,0,2,0"
                           Padding="0"
                           Appearance="Transparent"
                           Command="{Binding DuplicateCommand}"
                           IsEnabled="{Binding HasSelectedSearch}"
                           ToolTip="{loc:Loc Duplicate}">
                    <ui:SymbolIcon Symbol="Copy24" FontSize="15" />
                </ui:Button>
                <ui:Button Grid.Column="2"
                           Width="28"
                           MinHeight="30"
                           Padding="0"
                           Appearance="Transparent"
                           Command="{Binding DeleteCommand}"
                           IsEnabled="{Binding HasSelectedSearch}"
                           ToolTip="{loc:Loc Delete}">
                    <ui:SymbolIcon Symbol="Delete24" FontSize="15" />
                </ui:Button>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="0">
                <ListBox x:Name="SavedSearchesList"
                         Padding="2"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectedItem="{Binding SelectedSearch}">
                    <ListBox.Resources>
                        <controls:SavedSearchCollectionViewSource x:Key="FilteredSavedSearches"
                            Source="{Binding SavedSearches}" FilterText="{Binding SavedSearchFilter}" />
                    </ListBox.Resources>
                    <ListBox.ItemsSource>
                        <Binding Source="{StaticResource FilteredSavedSearches}" />
                    </ListBox.ItemsSource>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type search:SavedSearchPattern}">
                            <Grid Margin="4,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           FontSize="12"
                                           LineHeight="14"
                                           LineStackingStrategy="BlockLineHeight"
                                           Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Name}" />
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           FontFamily="{StaticResource JetBrainsMono}"
                                           FontSize="11"
                                           LineHeight="13"
                                           LineStackingStrategy="BlockLineHeight"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Pattern}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Pattern}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                           Margin="8,0,6,0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="Aa"
                                           ToolTip="{loc:Loc MatchCase}"
                                           Visibility="{Binding IsCaseSensitive, Converter={StaticResource BooleanToVisibility}}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Grid.RowSpan="2"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="(.*)"
                                           ToolTip="{loc:Loc UseRegex}"
                                           Visibility="{Binding UseRegex, Converter={StaticResource BooleanToVisibility}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Margin="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{loc:Loc NoSavedSearchesFound}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=SavedSearchesList, Path=HasItems}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="2">
                <Grid IsEnabled="{Binding HasSelectedSearch}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Margin="0,0,0,4"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{loc:Loc Name}" />
                    <ui:TextBox Grid.Row="1" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="2"
                               Margin="0,10,0,4"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{loc:Loc Pattern}" />
                    <ui:TextBox Grid.Row="3"
                                MinHeight="72"
                                AcceptsReturn="True"
                                FontFamily="{StaticResource JetBrainsMono}"
                                Text="{Binding EditPattern, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto" />
                    <TextBlock Grid.Row="4"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               Text="{Binding ValidationMessage}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasValidationMessage, Converter={StaticResource BooleanToVisibility}}" />
                    <WrapPanel Grid.Row="5" Margin="0,8,0,0">
                        <CheckBox Margin="0,0,16,0"
                                  Content="{loc:Loc MatchCase}"
                                  IsChecked="{Binding EditIsCaseSensitive}" />
                        <CheckBox Content="{loc:Loc UseRegex}"
                                  IsChecked="{Binding EditUseRegex}" />
                    </WrapPanel>
                    <Border Grid.Row="6"
                            Margin="0,8,0,0"
                            Padding="8,6"
                            CornerRadius="4"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            Visibility="{Binding IsReplaceConfirmationVisible, Converter={StaticResource BooleanToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc ReplaceSavedSearchConfirmation}" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,6,0,0">
                                <ui:Button Margin="0,0,6,0"
                                           Appearance="Primary"
                                           Command="{Binding ConfirmReplaceCommand}"
                                           Content="{loc:Loc Replace}" />
                                <ui:Button Command="{Binding CancelReplaceCommand}" Content="{loc:Loc Cancel}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <WrapPanel Grid.Row="7" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <ui:Button Margin="0,0,8,0"
                                   Command="{Binding CancelEditCommand}"
                                   IsEnabled="{Binding HasChanges}"
                                   Content="{loc:Loc Cancel}" />
                        <ui:Button Appearance="Primary"
                                   Command="{Binding SaveCommand}"
                                   IsEnabled="{Binding CanSave}"
                                   Content="{loc:Loc Save}" />
                    </WrapPanel>
                </Grid>
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{loc:Loc SelectSavedSearch}"
                           Visibility="{Binding HasNoSelectedSearch, Converter={StaticResource BooleanToVisibility}}" />
            </Grid>

            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                    Margin="0,8,0,0"
                    Padding="8,3"
                    CornerRadius="4"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    Visibility="{Binding CanUndoDelete, Converter={StaticResource BooleanToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12"
                               Text="{Binding DeletedSearchName, StringFormat={loc:Loc SavedSearchDeleted}}" />
                    <ui:Button Grid.Column="1"
                               MinHeight="24"
                               Padding="8,1"
                               Appearance="Transparent"
                               Command="{Binding UndoDeleteCommand}"
                               Content="{loc:Loc Undo}" />
                </Grid>
            </Border>
        </Grid>

        <ui:Button Grid.Row="1"
                   Width="0"
                   Height="0"
                   Padding="0"
                   BorderThickness="0"
                   Visibility="Collapsed"
                   IsCancel="True"
                   Focusable="False"
                   Click="OnCloseClick" />
    </Grid>
</ui:FluentWindow>
