<ui:FluentWindow x:Class="LogGrokX.UpdateWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Update available"
                 Width="480"
                 SizeToContent="Height"
                 Icon="pack://application:,,,/app.ico"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Update available"
                     ShowMinimize="False"
                     ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/app.ico" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="16,4,16,16">
            <StackPanel Orientation="Horizontal">
                <ui:ImageIcon Source="pack://application:,,,/app-large.png" Width="40" Height="40" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="18" FontWeight="SemiBold">
                        <Run Text="LogGrokX" />
                        <Run Text="{Binding NewVersion, Mode=OneWay}" />
                        <Run Text="is available" />
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="Current version:" />
                        <Run Text="{Binding CurrentVersion, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <TextBlock Margin="0,16,0,6" FontWeight="SemiBold" Text="What's new" />
            <Border MaxHeight="220"
                    Padding="8"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding ReleaseNotes, Mode=OneWay}" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
            <ui:HyperlinkButton Margin="0,4,0,0"
                                Padding="0"
                                Command="{Binding OpenReleasePageCommand}"
                                Content="Open release page" />

            <ProgressBar Margin="0,12,0,0"
                         Height="4"
                         Maximum="100"
                         Value="{Binding Progress, Mode=OneWay}"
                         Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding Status}" />

            <StackPanel Margin="0,16,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}">
                <ui:Button Command="{Binding SkipCommand}" Content="Skip this version" />
                <ui:Button Margin="8,0,0,0" Command="{Binding LaterCommand}" Content="Later" />
                <ui:Button Margin="8,0,0,0"
                           Appearance="Primary"
                           Command="{Binding UpdateCommand}"
                           Content="{Binding UpdateButtonText}" />
            </StackPanel>
            <StackPanel Margin="0,16,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}">
                <ui:Button Appearance="Primary" Command="{Binding LaterCommand}" Content="OK" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
