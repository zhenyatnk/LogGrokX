<ui:FluentWindow x:Class="LogGrokX.WhatsNewWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:loc="clr-namespace:LogGrokX.Localization"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:localControls="clr-namespace:LogGrokX.Controls"
                 Title="{loc:Loc WhatsNew}"
                 Width="520"
                 SizeToContent="Height"
                 Icon="pack://application:,,,/app.ico"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 FontFamily="{StaticResource AppFontFamily}"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False">
    <Grid UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <localControls:StableTitleBar Grid.Row="0"
                     Title="{loc:Loc WhatsNew}"
                     ShowMinimize="False"
                     ShowMaximize="False">
            <localControls:StableTitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/app.ico" Width="16" Height="16" />
            </localControls:StableTitleBar.Icon>
        </localControls:StableTitleBar>

        <StackPanel Grid.Row="1" Margin="24,8,24,24">
            <StackPanel Orientation="Horizontal">
                <ui:ImageIcon Source="pack://application:,,,/app-large.png" Width="40" Height="40" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                               Text="{Binding UpdatedTitle}" />
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{loc:Loc WhatsNewHint}" />
                </StackPanel>
            </StackPanel>

            <TextBlock Margin="0,24,0,8" FontWeight="SemiBold" Text="{loc:Loc WhatsNew}" />
            <Border MaxHeight="280"
                    Style="{StaticResource FluentCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding ReleaseNotes, Mode=OneWay}" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
            <ui:HyperlinkButton Margin="0,4,0,0"
                                Padding="0"
                                Command="{Binding OpenReleasePageCommand}"
                                Content="{loc:Loc OpenReleasePage}" />

            <ui:Button Margin="0,24,0,0"
                       MinWidth="88"
                       HorizontalAlignment="Right"
                       Appearance="Primary"
                       Command="{Binding CloseCommand}"
                       Content="{loc:Loc Ok}" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
